# Test environment. Home Assistant needs Python 3.14.2 from 2026.3 onwards,
# which most systems do not have yet, so this image pins the exact version the
# integration targets. The full Python image rather than -slim, because
# lru-dict is built from source and needs the libc headers for that.
FROM python:3.14

# pytest-homeassistant-custom-component brings Home Assistant itself, but not
# the requirements of the bluetooth component. The versions come from its
# manifest.json in the installed Home Assistant release.
RUN pip install --no-cache-dir \
      pytest-homeassistant-custom-component \
      "bleak==3.0.2" \
      "bleak-retry-connector==4.7.0" \
      "bluetooth-adapters==2.4.0" \
      "bluetooth-auto-recovery==1.6.4" \
      "bluetooth-data-tools==1.29.24" \
      "dbus-fast==5.0.22" \
      "habluetooth==6.26.11" \
      "aiousbwatcher==1.1.2" \
      "serialx==1.10.0"
WORKDIR /app
