# Test environment. Home Assistant needs Python 3.14.2 from 2026.3 onwards,
# which most systems do not have yet, so this image pins the exact version the
# integration targets. The full Python image rather than -slim, because
# lru-dict is built from source and needs the libc headers for that.
FROM python:3.14

COPY requirements-test.txt scripts/ha_test_requirements.py /tmp/setup/

# The bluetooth requirements come from the installed Home Assistant release
# itself; see the script for why they are not pinned by hand.
RUN pip install --no-cache-dir -r /tmp/setup/requirements-test.txt \
 && python /tmp/setup/ha_test_requirements.py > /tmp/setup/bluetooth.txt \
 && pip install --no-cache-dir -r /tmp/setup/bluetooth.txt \
 && pip install --no-cache-dir hansa-ble-protocol \
 && rm -rf /tmp/setup

WORKDIR /app
