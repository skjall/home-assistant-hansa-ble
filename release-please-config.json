{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/hansa_ble/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "custom_components/hansa_ble/manifest.json",
          "jsonpath": "$.requirements[?(@.match && @.match(/^hansa-ble-protocol==/))]"
        },
        {
          "type": "generic",
          "path": "lib/hansa_ble_protocol/pyproject.toml"
        }
      ]
    }
  }
}
